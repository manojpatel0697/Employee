# ─── Dependencies ────────────────────────────────────────────────
node_modules/

# ─── Next.js build output ─────────────────────────────────────────
.next/
out/

# ─── Environment files — NEVER commit any of these ───────────────
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
*.env

# ─── Supabase local dev ───────────────────────────────────────────
supabase/.branches
supabase/.temp

# ─── Logs ────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── OS / editor files ───────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# ─── TypeScript build cache ───────────────────────────────────────
tsconfig.tsbuildinfo
*.tsbuildinfo

# ─── Test coverage ────────────────────────────────────────────────
coverage/

# ─── Secrets / keys — extra safety net ───────────────────────────
*.pem
*.key
*.p12
*.pfx
secrets/
