# Supabase project URL — found in your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — NEVER expose to the browser; server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret token for the admin panel URL: /admin/<ADMIN_SECRET_KEY>
ADMIN_SECRET_KEY=your-secret-admin-token-here
