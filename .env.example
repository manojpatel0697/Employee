# ─────────────────────────────────────────────────────────────────
# AGENCY PORTAL — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Found in your Supabase project: Settings > API

# Public URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anonymous key — safe to expose to the browser (RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER ONLY, never expose to the browser
# This key bypasses RLS — guard all routes that use it with auth checks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin panel ───────────────────────────────────────────────────
# Secret token for the admin URL: /admin/<ADMIN_SECRET_KEY>
# Use a long random string (e.g. openssl rand -hex 16)
# Never share this key. Rotate it if you suspect it has leaked.
ADMIN_SECRET_KEY=generate-a-long-random-string-here

# ── Vercel deployment ─────────────────────────────────────────────
# Set NODE_ENV=production automatically on Vercel — do not set it here.
# Add all the above vars in the Vercel dashboard (Settings > Environment Variables).
